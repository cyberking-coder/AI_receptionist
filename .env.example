# ── LLM provider ─────────────────────────────────────────────
# Choose one: groq (free cloud, default) | anthropic | ollama (local) | openai
LLM_PROVIDER=groq

# Only the key for your chosen provider is needed.
# Groq: free key from https://console.groq.com/keys  (no install, no card)
GROQ_API_KEY=
# Anthropic: https://console.anthropic.com
ANTHROPIC_API_KEY=
# OpenAI (or any OpenAI-compatible endpoint)
OPENAI_API_KEY=

# Optional: override the model for whichever provider you picked.
# groq default: llama-3.3-70b-versatile | anthropic: claude-sonnet-5
# ollama: llama3.1 | openai: gpt-4o-mini
LLM_MODEL=

# Ollama only (fully local, no key). Default: http://localhost:11434/v1
# OLLAMA_BASE_URL=http://localhost:11434/v1

# ── Telephony (only needed for real phone calls, not for `npm run chat`) ──
# Twilio has a FREE trial with ~$15 credit and a free trial number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Voice / text-to-speech ───────────────────────────────────
# twilio (default, built-in) or elevenlabs (natural voice, free tier).
TTS_PROVIDER=twilio
# ElevenLabs: free key from https://elevenlabs.io -> Profile -> API Keys
ELEVENLABS_API_KEY=
# Voice ID (default is "Rachel"); browse voices in the ElevenLabs app.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_turbo_v2_5
# Public URL of THIS server (e.g. your ngrok https URL) so Twilio can fetch
# the generated audio. Required only when TTS_PROVIDER=elevenlabs.
PUBLIC_BASE_URL=
# Fallback Twilio voice used when ElevenLabs is off or unavailable.
TTS_VOICE=Polly.Joanna-Neural

# ── Calendar booking (optional) ──────────────────────────────
# Without these, appointments are logged to logs/bookings.jsonl for a human
# to confirm. With them, a real Google Calendar event is created.
# Path to (or inline JSON of) a Google service-account key with Calendar API
# enabled. Share the target calendar with the service account's email.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=
APPOINTMENT_TIMEZONE=America/New_York
APPOINTMENT_DURATION_MIN=30

# ── Business config ──────────────────────────────────────────
BUSINESS_NAME=Acme Dental

# Phone number (E.164, e.g. +15551234567) to transfer to when the agent
# can't help or the caller asks for a human. Leave blank to just apologize
# and end the call instead of transferring.
HUMAN_TRANSFER_NUMBER=

PORT=3000
