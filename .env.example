# ── LLM provider ─────────────────────────────────────────────
# Choose one: groq (free cloud, default) | anthropic | ollama (local) | openai
LLM_PROVIDER=groq

# Only the key for your chosen provider is needed.
# Groq: free key from https://console.groq.com/keys  (no install, no card)
GROQ_API_KEY=
# Anthropic: https://console.anthropic.com
ANTHROPIC_API_KEY=
# OpenAI (or any OpenAI-compatible endpoint)
OPENAI_API_KEY=

# Optional: override the model for whichever provider you picked.
# groq default: llama-3.3-70b-versatile | anthropic: claude-sonnet-5
# ollama: llama3.1 | openai: gpt-4o-mini
LLM_MODEL=

# Ollama only (fully local, no key). Default: http://localhost:11434/v1
# OLLAMA_BASE_URL=http://localhost:11434/v1

# ── Telephony (only needed for real phone calls, not for `npm run chat`) ──
# Twilio has a FREE trial with ~$15 credit and a free trial number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Business config ──────────────────────────────────────────
BUSINESS_NAME=Acme Dental
# Twilio TTS voice, e.g. Polly.Joanna-Neural, Polly.Matthew-Neural, Polly.Amy-Neural
TTS_VOICE=Polly.Joanna-Neural

# Phone number (E.164, e.g. +15551234567) to transfer to when the agent
# can't help or the caller asks for a human. Leave blank to just apologize
# and end the call instead of transferring.
HUMAN_TRANSFER_NUMBER=

PORT=3000
