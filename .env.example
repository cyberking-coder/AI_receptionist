# Twilio (https://console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Business config
BUSINESS_NAME=Acme Dental
# Twilio TTS voice, e.g. Polly.Joanna-Neural, Polly.Matthew-Neural, Polly.Amy-Neural
TTS_VOICE=Polly.Joanna-Neural

# Phone number (E.164, e.g. +15551234567) to transfer to when the agent
# can't help or the caller asks for a human. Leave blank to just apologize
# and end the call instead of transferring.
HUMAN_TRANSFER_NUMBER=

PORT=3000
